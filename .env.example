# =============================================================================
# Sehat-Agent AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Prisma) ---
DATABASE_URL="postgresql://user:password@localhost:5432/sehat_agent?schema=public"

# --- OCR / Vision ---
# "tesseract" for local Tesseract.js, "google_vision" for Google Cloud Vision API
OCR_PROVIDER=tesseract

# Google Cloud Vision API (if OCR_PROVIDER=google_vision)
GOOGLE_VISION_API_KEY=

# --- AI / LLM (for simplification & extraction) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Scheduling ---
# Timezone for medication reminder cron jobs
CRON_TIMEZONE=Asia/Karachi

# --- Storage ---
# Base URL for uploaded media (images, PDFs)
MEDIA_STORAGE_URL=http://localhost:3000/uploads

# --- Track B Integration ---
# Orchestrator endpoint for cross-track handoffs
ORCHESTRATOR_URL=http://localhost:4000
ORCHESTRATOR_API_KEY=

# Google Maps Places API (New) key (for GeoLocator agent)
# Enable "Places API (New)" on the key's Google Cloud project
GOOGLE_MAPS_API_KEY=

# --- Track B — Auto-Booking (Twilio Voice) ---
# Twilio credentials — obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio-provided phone number the outbound call originates from (E.164 format: +923001234567)
TWILIO_PHONE_NUMBER=
# SAFETY: In prototype phase, calls are ONLY placed to this number — never to a real hospital line.
# Set this to your own mobile number for testing (E.164 format: +923001234567)
TWILIO_TEST_NUMBER=
# Publicly reachable base URL for TwiML webhooks (Twilio cannot reach localhost).
# Run `ngrok http 3000` and paste the HTTPS URL here (e.g. https://abcd1234.ngrok-free.app)
PUBLIC_BASE_URL=

# --- Logging ---
LOG_LEVEL=debug
